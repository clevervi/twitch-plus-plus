{
  "name": "twitch-plus-plus",
  "version": "2.2.11",
  "description": "Twitch++ — userscript modular, autoactualizable y extensible desde el repo (OLED, sidebar, chat, analítica de viewers, auto Channel Points, pausa de chat).",
  "type": "module",
  "license": "MIT",
  "author": "clevervi <adriandariov@gmail.com>",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clevervi/twitch-plus-plus.git"
  },
  "homepage": "https://github.com/clevervi/twitch-plus-plus",
  "bugs": {
    "url": "https://github.com/clevervi/twitch-plus-plus/issues"
  },
  "keywords": [
    "twitch",
    "userscript",
    "tampermonkey",
    "greasyfork",
    "oled",
    "chat"
  ],
  "files": [
    "dist",
    "src",
    "catalog.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "lint": "node scripts/lint.mjs",
    "lint:lang": "node tools/check-language.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser/*.test.mjs",
    "test:all": "npm run test && npm run test:browser",
    "verify": "node scripts/lint.mjs && node tools/check-language.mjs && node scripts/build.mjs && node --test test/*.test.mjs",
    "bump": "node scripts/bump.mjs",
    "release": "node scripts/bump.mjs && node scripts/build.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.0"
  }
}
